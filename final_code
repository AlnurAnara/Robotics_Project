#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
import random
import math
import os

from turtlesim.msg import Pose
from geometry_msgs.msg import Twist
from turtlesim.srv import Spawn, SetPen, TeleportAbsolute

class CombinedSnakeGame(Node):
    def __init__(self):
        super().__init__('combined_snake_game')
        
        self.score = 0
        self.best_score = 0
        self.collision_threshold = 0.8  
        
        self.food_types = {
            'normal': {'points': 1, 'name': 'Normal (1 pt)'},
            'gold':   {'points': 3, 'name': 'Gold (3 pts)'},
            'ruby':   {'points': 5, 'name': 'Ruby (5 pts)'},
        }
        self.current_food_type = self.choose_food_type()
        
        self.food_x, self.food_y = self.random_position()
        self.bomb_x, self.bomb_y = self.random_position()

        self.turtle_names = ['turtle1']  
        self.poses = {}                  
        self.cmd_pubs = {}               
        self.pose_subs = {}              

        self.pose_subs['turtle1'] = self.create_subscription(
            Pose, '/turtle1/pose', 
            self.head_pose_callback, 10
        )

        self.spawn_cli = self.create_client(Spawn, '/spawn')
        
        self.turn_off_pen('turtle1')
        
        self.spawn_entity('food', self.food_x, self.food_y)
        self.spawn_entity('bomb', self.bomb_x, self.bomb_y)
        
        self.print_scoreboard("Game Started! Move turtle1 to eat food!")

    def head_pose_callback(self, msg):
        self.poses['turtle1'] = msg
        
        if msg.x <= 0.0 or msg.x >= 11.0 or msg.y <= 0.0 or msg.y >= 11.0:
            self.game_over()
            return

        dist_food = math.hypot(msg.x - self.food_x, msg.y - self.food_y)
        if dist_food < self.collision_threshold:
            points = self.food_types[self.current_food_type]['points']
            self.score += points
            if self.score > self.best_score:
                self.best_score = self.score
            
            self.print_scoreboard(f"YUM! Ate {self.current_food_type} food (+{points})")
            
            self.current_food_type = self.choose_food_type()
            self.food_x, self.food_y = self.random_position()
            self.teleport_entity('food', self.food_x, self.food_y)
            
            self.spawn_new_follower()

        dist_bomb = math.hypot(msg.x - self.bomb_x, msg.y - self.bomb_y)
        if dist_bomb < self.collision_threshold:
            self.score -= 1
            self.print_scoreboard("BOOM! You hit a bomb (-1)")
            
            self.bomb_x, self.bomb_y = self.random_position()
            self.teleport_entity('bomb', self.bomb_x, self.bomb_y)

        self.move_followers()

    def move_followers(self):
        if len(self.turtle_names) <= 1:
            return
            
        for i in range(1, len(self.turtle_names)):
            leader_name = self.turtle_names[i-1]
            follower_name = self.turtle_names[i]

            leader_pose = self.poses.get(leader_name)
            follower_pose = self.poses.get(follower_name)

            if not leader_pose or not follower_pose:
                continue

            delta_pos = math.hypot(leader_pose.x - follower_pose.x, leader_pose.y - follower_pose.y)
            ang_goal = math.atan2(leader_pose.y - follower_pose.y, leader_pose.x - follower_pose.x)
            delta_ang = math.atan2(math.sin(ang_goal - follower_pose.theta), math.cos(ang_goal - follower_pose.theta))

            new_vel = Twist()
            if delta_pos > 0.7:
                kl = 3.0   
                ka = 15.0  
                new_vel.linear.x = kl * delta_pos
                new_vel.angular.z = ka * delta_ang

            if follower_name in self.cmd_pubs:
                self.cmd_pubs[follower_name].publish(new_vel)

    def follower_pose_callback(self, msg, name):
        self.poses[name] = msg

    def spawn_new_follower(self):
        new_idx = len(self.turtle_names) + 1
        new_name = f'turtle{new_idx}'
        
        last_name = self.turtle_names[-1]
        last_pose = self.poses.get(last_name)
        spawn_x = last_pose.x if last_pose else 5.5
        spawn_y = last_pose.y if last_pose else 5.5

        if self.spawn_cli.wait_for_service(timeout_sec=1.0):
            req = Spawn.Request(x=spawn_x, y=spawn_y, theta=0.0, name=new_name)
            future = self.spawn_cli.call_async(req)
            future.add_done_callback(lambda f, n=new_name: self.on_follower_spawned(f, n))

    def on_follower_spawned(self, future, name):
        try:
            future.result()
            self.turn_off_pen(name)
            
            self.cmd_pubs[name] = self.create_publisher(Twist, f'/{name}/cmd_vel', 10)
            self.pose_subs[name] = self.create_subscription(
                Pose, f'/{name}/pose', 
                lambda msg, n=name: self.follower_pose_callback(msg, n), 
                10
            )
            self.turtle_names.append(name)
        except Exception as e:
            self.get_logger().error(f"Failed to spawn {name}: {e}")

    def spawn_entity(self, name, x, y):
        if self.spawn_cli.wait_for_service(timeout_sec=1.0):
            req = Spawn.Request(x=x, y=y, theta=0.0, name=name)
            future = self.spawn_cli.call_async(req)
            future.add_done_callback(lambda f, n=name: self.post_spawn_entity(f, n))

    def post_spawn_entity(self, future, name):
        try:
            future.result()
            self.turn_off_pen(name)
        except Exception:
            pass

    def turn_off_pen(self, name):
        cli = self.create_client(SetPen, f'/{name}/set_pen')
        if cli.wait_for_service(timeout_sec=1.0):
            req = SetPen.Request(off=1, width=0)
            cli.call_async(req)

    def teleport_entity(self, name, x, y):
        cli = self.create_client(TeleportAbsolute, f'/{name}/teleport_absolute')
        if cli.wait_for_service(timeout_sec=1.0):
            req = TeleportAbsolute.Request(x=x, y=y, theta=0.0)
            cli.call_async(req)

    def choose_food_type(self):
        x = random.random()
        if x < 0.70: return 'normal'
        elif x < 0.92: return 'gold'
        return 'ruby'

    def random_position(self):
        return random.uniform(1.0, 10.0), random.uniform(1.0, 10.0)

    def print_scoreboard(self, message=""):
        os.system('cls' if os.name == 'nt' else 'clear')
        print("==================================================")
        print(f" BEST SCORE: {self.best_score}   |   CURRENT SCORE: {self.score}")
        print(f" SNAKE LENGTH: {len(self.turtle_names)} |   TARGET: {self.food_types[self.current_food_type]['name']}")
        print("==================================================")
        print(f">> {message}")
        print("==================================================")

    def game_over(self):
        os.system('cls' if os.name == 'nt' else 'clear')
        print("==================================================")
        print("        💀 YOU HIT THE WALL! GAME OVER 💀        ")
        print(f" FINAL SCORE: {self.score}  |  BEST SCORE: {self.best_score}  |  LENGTH: {len(self.turtle_names)}")
        print("==================================================")
        rclpy.shutdown()

def main(args=None):
    rclpy.init(args=args)
    game_node = CombinedSnakeGame()

    try:
        rclpy.spin(game_node)
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            game_node.destroy_node()
            rclpy.try_shutdown()

if __name__ == '__main__':
    main()
